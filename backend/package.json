{
  "name": "hrms-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/modules/sources/worker.ts",
    "build": "prisma generate",
    "start": "tsx src/index.ts",
    "start:worker": "tsx src/modules/sources/worker.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:setup": "prisma db push",
    "prisma:generate": "prisma generate",
    "start:prod": "node scripts/migrate.mjs && tsx src/index.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "reset-data": "tsx scripts/reset-data.ts",
    "test": "tsx tests/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8",
    "cron-parser": "^4.9.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "imapflow": "^1.0.170",
    "mailparser": "^3.7.1",
    "pdfjs-dist": "5.6.205",
    "tsx": "^4.19.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.4.2",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "@types/mailparser": "^3.4.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}